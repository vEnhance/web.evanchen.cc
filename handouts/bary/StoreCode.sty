\newcommand{\TempToTeX}[1]{%
\ifOSisUnix%
	\immediate\write18{cat \@nameuse{#1TempFile} > \@nameuse{#1TeXFile}}
	%\immediate\write18{more +4 \@nameuse{#1TempFile} > \@nameuse{#1TeXFile}}
\else%
	\immediate\write18{type \@nameuse{#1TempFile} > \@nameuse{#1TeXFile}}
\fi
}
