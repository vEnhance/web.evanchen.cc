draw(scale(0.9)*Label("B"),0.8*ENE);
draw(scale(1.1)*anglemark(P,B,C));
draw(scale(0.9)*Label("A"),0.8*ESE);
draw(anglemark(B,C,P));
draw(scale(0.9)*Label("A"),C, 4*WSW);
draw(anglemark(A,C,B));
draw(scale(0.9)*Label("C"),C, 4*NW);
