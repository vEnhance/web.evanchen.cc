\ifevansetup
	%Setup Title/Auth/Date
	\AtBeginDocument{
	\author{Evan Chen}
	\date{\today}}

	%Loads a bunch of useful packages
	\ifevanpkg
		\usepackage{listings}
		\usepackage{paralist}
		\usepackage{titling}
		%If we have titling...
		\newlength{\posttitledrop} \setlength{\posttitledrop}{-2.2em}
		\newlength{\postauthordrop} \setlength{\postauthordrop}{-2.2em}

		\ifevantitling
		\pretitle{\begin{center}\bfseries\large}
		\posttitle{\end{center}\vspace{\posttitledrop}}
		\preauthor{\begin{center} \scshape}
		\postauthor{\end{center}\vspace{\postauthordrop}}
		\predate{\begin{center}\small}
		\postdate{\end{center}}

		\else

		\fi
	\else
	\fi

	\ifevanthm
		%New Theorem Styles
		\theoremstyle{plain}
		%Branching here: the option secthm changes theorems to be labelled by section
		\ifevansecthm
			\newtheorem{theorem}{Theorem}[section]
		\else
			\newtheorem{theorem}{Theorem}
		\fi
		\newtheorem{lemma}[theorem]{Lemma}
		\newtheorem{conjecture}[theorem]{Conjecture}
		\newtheorem{corollary}[theorem]{Corollary}
		\newtheorem{proposition}[theorem]{Proposition}

		%These are more universal
		\theoremstyle{definition}
		\newtheorem{algorithm}[theorem]{Algorithm}
		\newtheorem{case}{Case}
		\newtheorem*{claim}{Claim}
		\newtheorem*{counterexample}{Counterexample}
		\newtheorem*{definition}{Definition}
		\newtheorem*{example}{Example}
		\newtheorem*{exercise}{Exercise}
		\newtheorem*{fact}{Fact}
		\newtheorem*{note}{Note}
		\newtheorem*{notation}{Notation}
		\newtheorem*{problem}{Problem}
		\newtheorem*{remark}{Remark}
		\newtheorem*{question}{Question}
		\newtheorem{puzzle}{Puzzle}
		\newtheorem*{joke}{Joke}
		\newtheorem*{motivation}{Motivation}
	\else
	\fi

	%Page Setup
	\ifevanfancy
		\usepackage{fancyhdr}
		\setlength{\headheight}{0.75in}
		\setlength{\oddsidemargin}{0in}
		\setlength{\evensidemargin}{0in}
		\setlength{\voffset}{-1.0in}
		\setlength{\headsep}{10pt}
		\setlength{\textwidth}{6.5in}
		\setlength{\headwidth}{6.5in}
		\setlength{\textheight}{8.75in}
		\setlength{\parskip}{1ex plus 0.5ex minus 0.2ex}
		\setlength{\textwidth}{6.5in}

		\addtolength{\headheight}{-0.4in}
		\addtolength{\textheight}{1in}
		\setlength{\footskip}{0.3in}

		\@ifundefined{KOMAClassName}
		{
			\addtolength{\posttitledrop}{0.4em}
			\addtolength{\postauthordrop}{0.2em}
		}
		{
			\addtolength{\headheight}{1cm}
			\addtolength{\textheight}{2cm}
		}


			%Setup FancyHeaders
			\ifevanhdr
			\renewcommand{\headrulewidth}{0.5pt}
			\renewcommand{\footrulewidth}{0.3pt}
			\pagestyle{fancy}
			\lhead{\thetitle, by Evan Chen}
			\chead{}
			\rhead{\thepage}
			\lfoot{\today}
			\cfoot{}
			\rfoot{}  %\rfoot{Page \thepage \  of \pageref{LastPage}}
			\else
			\fi
	\else
	\fi

	%Href
	\ifevanhref
		\usepackage{hyperref}
	\else
	\fi

	\ifevanmassive
		\usepackage{anyfontsize}
		%Custom Font Size Commands
		\newcommand{\massive}{\fontsize{48}{53}\selectfont}
		\newcommand{\Massive}{\fontsize{60}{66}\selectfont}
		\newcommand{\MASSIVE}{\fontsize{72}{79}\selectfont}
		\newcommand{\colossal}{\fontsize{120}{132}\selectfont}
		\newcommand{\Colossal}{\fontsize{180}{198}\selectfont}
		\newcommand{\COLOSSAL}{\fontsize{240}{264}\selectfont}
	\else
	\fi

\else
